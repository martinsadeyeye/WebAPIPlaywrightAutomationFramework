Create locators/LoginLocators.ts
import { Page } from '@playwright/test';

//Playwright's getByTestId() uses data-testid by default
export const LoginLocators = (page: Page) => ({
    usernameInput: page.getByTestId('username-input'),
    passwordInput: page.getByTestId('password-input'),
    loginButton: page.getByTestId('login-button'),
    errorMessage: page.getByTestId('error-message'),
});



Update pages/LoginPage.ts
Your Page Object no longer needs to declare every locator separately inside the constructor.
import { Page } from '@playwright/test';
import { UIActions } from '../utils/UIActions';
import { LoginLocators } from '../locators/LoginLocators';

export class LoginPage {
    private readonly actions: UIActions;
    private readonly locators: ReturnType<typeof LoginLocators>;

    constructor(private readonly page: Page) {
        this.actions = new UIActions(page);
        this.locators = LoginLocators(page);
    }

    async goto(): Promise<void> {
        await this.page.goto('https://www.saucedemo.com/');
    }

    async fillUsername(username: string): Promise<void> {
        await this.actions.fillText(
            this.locators.usernameInput,
            username
        );
    }

    async fillPassword(password: string): Promise<void> {
        await this.actions.fillPassword(
            this.locators.passwordInput,
            password
        );
    }

    async submit(): Promise<void> {
        await this.actions.clickButton(
            this.locators.loginButton
        );
    }

    async login(username: string, password: string): Promise<void> {
        await this.fillUsername(username);
        await this.fillPassword(password);
        await this.submit();
    }
}



4. Call the Page Object from your test
import { test, expect } from '@playwright/test';
import { LoginPage } from '../pages/LoginPage';

test('User can log in successfully', async ({ page }) => {
    const loginPage = new LoginPage(page);

    await loginPage.goto();
    await loginPage.login('standard_user', 'secret_sauce');

    await expect(page).toHaveURL(/inventory/);
});